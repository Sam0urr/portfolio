---
/**
 * Note article. The masthead is sticky and its lower hairline is the reading-progress
 * rule (Base `progress`). Header at the wide measure — tag kicker, title at 2xl,
 * standfirst, byline between hairlines — then the essay body at the prose measure
 * inside the margin / prose / margin grid, so "§ n" numerals hang left and side
 * figures hang right. Ends with a double rule and prev / next.
 */
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Prose from '../components/Prose.astro';
import { SITE } from '../consts';
import { formatDate, toISODate } from '../scripts/format';

type Note = CollectionEntry<'notes'>;
type Adjacent = Pick<Note, 'id' | 'data'>;

interface Props {
  entry: Note;
  /** Minutes; the page computes it (words / 230). */
  readingTime: number;
  /** The older note. */
  prev?: Adjacent;
  /** The newer note. */
  next?: Adjacent;
}

const { entry, readingTime, prev, next } = Astro.props;
const { title, summary, date, updated, tags } = entry.data;

const dateISO = toISODate(date);
const updatedISO = updated ? toISODate(updated) : null;
// "Updated 15 May" when the year is unchanged, else the full date; nothing if same day.
const updatedLabel =
  updated && updatedISO !== dateISO
    ? updated.getUTCFullYear() === date.getUTCFullYear()
      ? formatDate(updated).replace(/ \d{4}$/, '')
      : formatDate(updated)
    : null;
const tagHref = (tag: string) => `/notes/?tags=${encodeURIComponent(tag)}`;
---

<Base title={title} description={summary} type="article" progress published={date} updated={updated}>
  <article class="article-grid note" data-reading-target>
    <header class="note-header">
      {
        tags.length > 0 && (
          <ul class="note-tags" aria-label="Tags" data-load-reveal style="--i: 0">
            {tags.map((tag) => (
              <li>
                <a href={tagHref(tag)}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
      <h1 class="note-title" data-load-reveal style="--i: 1">{title}</h1>
      {summary && <p class="lede note-lede" data-load-reveal style="--i: 2">{summary}</p>}
      <p class="byline note-byline" data-load-reveal style="--i: 3">
        By {SITE.author} · <time datetime={dateISO}>{formatDate(date)}</time>
        {updatedLabel && updatedISO && (
          <>
            {' · '}Updated <time datetime={updatedISO}>{updatedLabel}</time>
          </>
        )}
        {' · '}{readingTime} min read
      </p>
    </header>
    <Prose variant="essay">
      <slot />
    </Prose>
  </article>

  <footer class="article-grid note-footer">
    <div class="note-end">
      <div class="rule-double" aria-hidden="true"></div>
      <nav class="pager" aria-label="Adjacent notes" data-reveal>
        <div class="pager-cell">
          {
            prev && (
              <>
                <span class="meta">← Previous</span>
                <a class="pager-title" href={`/notes/${prev.id}/`}>{prev.data.title}</a>
              </>
            )
          }
        </div>
        <div class="pager-cell">
          {
            next && (
              <>
                <span class="meta">Next →</span>
                <a class="pager-title" href={`/notes/${next.id}/`}>{next.data.title}</a>
              </>
            )
          }
        </div>
      </nav>
    </div>
  </footer>
</Base>

<style>
  /* Header and footer share the body's left edge and extend into the right margin. */
  .note-header,
  .note-end {
    grid-column: 2 / 4;
    max-width: var(--measure-wide);
  }
  .note-header { margin-bottom: var(--space-12); }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0.6em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-feature-settings: "lnum", "tnum";
  }
  .note-tags li + li::before {
    content: "·";
    margin-right: 0.6em;
    color: var(--color-muted);
  }
  .note-tags a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms var(--ease);
  }
  .note-tags a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .note-title {
    margin: var(--space-4) 0 0;
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .note-lede {
    margin: var(--space-6) 0 0;
    max-width: var(--measure-wide);
  }
  .note-byline {
    margin: var(--space-8) 0 0;
    padding-block: var(--space-3);
    border-top: var(--rule);
    border-bottom: var(--rule);
  }

  .note-footer { margin-top: var(--space-16); }
  .note-end .pager {
    margin-top: 0;
    padding-top: var(--space-2);
    border-top: 0;
  }
  .pager .meta { display: block; }

  @media (max-width: 63.9375rem) {
    .note-header,
    .note-end { grid-column: 1; }
  }
</style>
