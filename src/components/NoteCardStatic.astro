---
import { formatDate, toISODate } from '../scripts/format';

/**
 * One note as a hairline row (server-rendered): mono date + read time column,
 * Display-face title linking to /notes/<slug>/, summary, muted tags.
 * Put rows inside <ul class="rows" data-reveal-group> (or <div class="rows">).
 */
interface Props {
  slug: string;
  title: string;
  summary: string;
  date: Date | string;
  tags: string[];
  /** Minutes; rendered as "· 9 min" after the date. */
  readingTime?: number;
  /** Heading level for the title (h3 by default; h2 on the Notes index). */
  as?: 'h2' | 'h3';
  /** Render as <li> (inside <ul class="rows">) or <article>. */
  tag?: 'li' | 'article';
  class?: string;
}

const {
  slug,
  title,
  summary,
  date,
  tags,
  readingTime,
  as: Heading = 'h3',
  tag: Tag = 'li',
  class: className,
} = Astro.props;
const href = `/notes/${slug}/`;
---

<Tag class:list={['row', className]}>
  <div class="row-meta">
    <time datetime={toISODate(date)}>{formatDate(date)}</time>
    {readingTime ? <span> · {readingTime} min</span> : null}
  </div>
  <div class="row-body">
    <Heading class="row-title"><a href={href}>{title}</a></Heading>
    {summary && <p class="row-summary">{summary}</p>}
  </div>
  {
    tags.length > 0 && (
      <ul class="row-aside" aria-label="Tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</Tag>
