---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-reveal>
  <div class="wrap">
    <div class="rule-double rule-draw-on-reveal" aria-hidden="true"></div>
    <div class="footer-grid">
      <p>Set in Newsreader and Source Serif. Built with <a href="https://astro.build/">Astro</a>.</p>
      <p>
        <a href={SITE.linkedin} rel="me">LinkedIn</a> · <a href={`mailto:${SITE.email}`}>Email</a>
      </p>
      <p>
        <a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Sitemap</a> · © {year} {SITE.name}
      </p>
    </div>
  </div>
</footer>
