---
/**
 * Download row: "↓ Label" in mono between two hairlines. The arrow is the only icon
 * the site allows. PDFs open in the browser (no `download` attribute) so they can
 * be read before being saved.
 */
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="download" href={href}>
  <span class="download-mark" aria-hidden="true">↓</span>
  <span>{label}</span>
</a>
