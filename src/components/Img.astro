---
/**
 * Content image: <figure> with a hairline-bordered, optimised <img> and an optional
 * mono caption — the `caption` prop, or the default slot when the caption carries
 * markup (links, <em>). `class` lands on the <figure> so content can float or size it.
 *
 * `src` keeps the public-style path the content has always used ("/images/notes/x.png");
 * the file itself lives under src/assets/images/ and is served through astro:assets,
 * which emits width/height, an AVIF srcset with a WebP fallback at `widths` and a
 * `sizes` hint. Unknown paths fail the build rather than shipping a broken image.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  class?: string;
  caption?: string;
  /** Rendered widths (px) for the srcset; widths beyond the source are capped at the source width. */
  widths?: number[];
  /** `sizes` attribute; defaults to the prose measure (full width on phones). */
  sizes?: string;
  /** In the first viewport: loading="eager" instead of lazy. */
  eager?: boolean;
  /** The page's LCP image: adds fetchpriority="high" (implies eager). Leave off for other in-view images. */
  priority?: boolean;
  /** Columns spanned inside a `.fig-grid` (12-column frame): 4 (default), 8 or 12. */
  span?: 4 | 8 | 12;
}

const DEFAULT_WIDTHS = [440, 880, 1280];
const DEFAULT_SIZES = '(max-width: 47.9375rem) calc(100vw - 2rem), 640px';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true },
);

const { src, alt, class: className, caption, widths, sizes, priority = false, eager = priority, span } = Astro.props;

const key = '/src/assets/images/' + src.replace(/^\/?(images\/)?/, '');
const imported = images[key]?.default;
if (!imported) throw new Error(`<Img>: "${src}" not found — expected ${key}`);
// At build time the metadata is a Proxy that marks the original file as "referenced"
// (so it is kept in dist/) on any ordinary property read. Dimensions are read from
// `clone`, the plain copy Astro's own <Image> reads; the proxy itself goes to <Image>,
// which needs its (non-enumerable) fsPath to prune the original after processing.
const image: ImageMetadata = (imported as ImageMetadata & { clone?: ImageMetadata }).clone ?? imported;

// Never upscale: drop requested widths past the source and cap the list at the source width.
const requested = (widths ?? DEFAULT_WIDTHS).filter((w) => Number.isFinite(w) && w > 0);
const capped = requested.filter((w) => w < image.width);
if (capped.length < requested.length) capped.push(image.width);
const widthList = Array.from(new Set(capped.length > 0 ? capped : [image.width])).sort((a, b) => a - b);
const largest = widthList[widthList.length - 1];

const hasCaption = Boolean(caption) || Astro.slots.has('default');
---

<figure class:list={['fig', span === 8 && 'span-8', span === 12 && 'span-12', className]}>
  <Picture
    src={imported}
    alt={alt}
    width={largest}
    widths={widthList}
    sizes={sizes ?? DEFAULT_SIZES}
    formats={['avif']}
    fallbackFormat="webp"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
  {
    hasCaption && (
      <figcaption>
        {caption}
        <slot />
      </figcaption>
    )
  }
</figure>
