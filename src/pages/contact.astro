---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { SITE } from '../consts';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing content entry: pages/contact');
const { Content, headings } = await render(entry);
const description = entry.data.summary ?? 'How to reach Sam Lamrabte: email and LinkedIn. Based in Amsterdam.';
---

<Page title={entry.data.title} description={description} kicker={entry.data.kicker} lede={entry.data.summary} headings={headings}>
  <div slot="before" class="contact-address">
    <a class="ui-link" href={`mailto:${SITE.email}`} data-load-reveal style="--i: 2">Email ↗</a>
    <a class="ui-link" href={SITE.linkedin} rel="me" data-load-reveal style="--i: 3">LinkedIn ↗</a>
  </div>
  <Content />
</Page>

<style>
  /* Two labelled links, the address itself stays behind the mailto. */
  .contact-address {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }
</style>
