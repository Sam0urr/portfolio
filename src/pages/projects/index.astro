---
import { getCollection, getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';

const entry = await getEntry('pages', 'projects');
if (!entry) throw new Error('Missing content entry: pages/projects');
const { Content, headings } = await render(entry);
const description =
  entry.data.summary ??
  'Projects by Sam Lamrabte: a geopolitical-risk map, an MSc thesis, a climate-adaptation case study for the City of Amsterdam, and more.';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.title.localeCompare(b.data.title),
);
---

<Page title={entry.data.title} description={description} kicker={entry.data.kicker} lede={entry.data.summary} headings={headings}>
  <Content />
  <section slot="after" class="section" aria-labelledby="case-studies">
    <h2 id="case-studies" class="section-head">§ 01 · Case studies</h2>
    <ul class="rows" data-reveal-group>
      {
        projects.map((project) => (
          <li class="row">
            <div class="row-meta">{project.data.year ?? '—'}</div>
            <div class="row-body">
              <h3 class="row-title">
                <a href={`/projects/${project.id}/`}>{project.data.title}</a>
              </h3>
              <p class="row-summary">{project.data.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Page>
