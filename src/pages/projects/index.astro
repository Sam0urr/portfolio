---
import { getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';

/**
 * Projects index: the "Selected work" prose from content/pages/projects.mdx, one h2 per
 * project. A project with a full case-study page links to it from its own entry, so the
 * index never lists the same project twice.
 */
const entry = await getEntry('pages', 'projects');
if (!entry) throw new Error('Missing content entry: pages/projects');
const { Content, headings } = await render(entry);
const description =
  entry.data.summary ??
  'Projects by Sam Lamrabte: a geopolitical-risk map, an MSc thesis, a climate-adaptation case study for the City of Amsterdam, and more.';
---

<Page title={entry.data.title} description={description} kicker={entry.data.kicker} lede={entry.data.summary} headings={headings}>
  <Content />
</Page>
