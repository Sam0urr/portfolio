---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';

const entry = await getEntry('pages', 'references');
if (!entry) throw new Error('Missing content entry: pages/references');
const { Content, headings } = await render(entry);
const description =
  entry.data.summary ??
  'Written references for Sam Lamrabte from the UN Global Compact and Baruch College, and a UN certificate of appreciation, as PDFs.';
---

<Page title={entry.data.title} description={description} kicker={entry.data.kicker} lede={entry.data.summary} headings={headings} revealHeadings>
  <Content />
</Page>
