---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { SITE } from '../consts';

const entry = await getEntry('pages', 'cv');
if (!entry) throw new Error('Missing content entry: pages/cv');
const { Content, headings } = await render(entry);
const description =
  entry.data.summary ??
  'Curriculum vitae of Sam Lamrabte: education, experience, awards, certifications, projects and languages, with the full CV as a PDF.';
---

<Page title={entry.data.title} description={description} kicker={SITE.dateline} lede={entry.data.summary} headings={headings} variant="cv">
  <Content />
</Page>
