---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing content entry: pages/about');
const { Content, headings } = await render(entry);
const description =
  entry.data.summary ??
  'About Sam Lamrabte: an analyst and political economist working across technology governance, EU digital regulation and sustainability policy.';
---

<Page title={entry.data.title} description={description} kicker={entry.data.kicker} lede={entry.data.summary} headings={headings}>
  <Content />
</Page>
